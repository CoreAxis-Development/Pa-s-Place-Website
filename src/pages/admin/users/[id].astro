---
// Add or manage a staff account. New accounts and password resets get a
// temporary password that must be changed at the next sign-in.
import { ZodError } from 'zod';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ROLE_LABELS, canManageRole } from '../../../server/auth/session';
import { MIN_PASSWORD_LENGTH } from '../../../server/auth/password';
import type { Role } from '../../../server/db/schema';
import { currentUser, deny, fieldErrors, setFlash, str } from '../../../server/http/request';
import { UserError, createUser, deleteUser, getUser, resetPassword, updateUser } from '../../../server/services/users';

const user = currentUser(Astro);
const denied = deny(Astro, 'manage-users');
if (denied) return denied;

const id = Astro.params.id!;
const isNew = id === 'new';
const here = `/admin/users/${id}`;
const target = isNew ? null : await getUser(id);
if (!isNew && !target) {
  setFlash(Astro, 'That account no longer exists.', 'warning');
  return Astro.redirect('/admin/users');
}
if (target && !canManageRole(user, target.role) && target.id !== user.id) {
  setFlash(Astro, 'Only an owner can manage that account.', 'danger');
  return Astro.redirect('/admin/users');
}

const roles = (Object.keys(ROLE_LABELS) as Role[]).filter((r) => canManageRole(user, r)).reverse();
let v = { name: target?.name ?? '', email: target?.email ?? '', role: (target?.role ?? 'editor') as string, active: target?.active ?? true };
let errors: Record<string, string> = {};
let problem = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = str(form, '_action');
  try {
    if (action === 'delete' && target) {
      await deleteUser(target.id, user);
      setFlash(Astro, `The account for ${target.name} was deleted.`);
      return Astro.redirect('/admin/users');
    }
    if (action === 'reset' && target) {
      await resetPassword(target.id, str(form, 'password'), user);
      setFlash(Astro, `Temporary password set for ${target.name}. They are signed out everywhere and must choose a new one at sign-in.`);
      return Astro.redirect(here);
    }
    v = { name: str(form, 'name'), email: str(form, 'email'), role: str(form, 'role'), active: isNew || form.get('active') === 'on' };
    const input = { name: v.name, email: v.email, role: v.role as Role };
    if (isNew) {
      const created = await createUser({ ...input, password: str(form, 'password') }, user);
      setFlash(Astro, `Account created for ${created.name}. Give them the temporary password; they will choose their own at first sign-in.`);
    } else {
      await updateUser(target!.id, { ...input, active: v.active }, user);
      setFlash(Astro, 'Account updated.');
    }
    return Astro.redirect('/admin/users');
  } catch (err) {
    if (err instanceof ZodError) {
      errors = fieldErrors(err);
      // a bare password schema reports its problem without a field name
      if (errors._) errors.password = errors._;
      problem = 'Please check the highlighted details.';
    } else if (err instanceof UserError) problem = err.message;
    else throw err;
  }
}
const isSelf = target?.id === user.id;
---

<AdminLayout title={isNew ? 'Add a staff member' : target!.name} subtitle={isNew ? undefined : target!.email}>
  <a slot="breadcrumb" href="/admin/users" class="link">Staff</a>

  {problem && <p class="alert alert-danger mb-5" role="alert">{problem}</p>}

  <div class="grid max-w-4xl gap-5">
    <form method="post" class="a-card a-card-pad">
      <h2 class="a-card-title">Account</h2>
      <div class="a-form-grid mt-4">
        <div>
          <label class="label" for="name">Full name</label>
          <input class="input" id="name" name="name" value={v.name} required aria-invalid={errors.name ? 'true' : undefined} />
          {errors.name && <p class="field-error">{errors.name}</p>}
        </div>
        <div>
          <label class="label" for="email">Email (used to sign in)</label>
          <input class="input" id="email" name="email" type="email" value={v.email} required autocomplete="off" aria-invalid={errors.email ? 'true' : undefined} />
          {errors.email && <p class="field-error">{errors.email}</p>}
        </div>
        <div>
          <label class="label" for="role">Role</label>
          <select class="input" id="role" name="role" disabled={isSelf}>
            {(isSelf ? [target!.role] : roles).map((r) => <option value={r} selected={r === v.role}>{ROLE_LABELS[r].label}: {ROLE_LABELS[r].summary}</option>)}
          </select>
          {isSelf && <input type="hidden" name="role" value={target!.role} />}
          {isSelf && <p class="help">You cannot change your own role.</p>}
        </div>
        {
          isNew ? (
            <div>
              <label class="label" for="password">Temporary password</label>
              <input class="input" id="password" name="password" type="text" autocomplete="off" minlength={MIN_PASSWORD_LENGTH} required aria-invalid={errors.password ? 'true' : undefined} />
              {errors.password ? <p class="field-error">{errors.password}</p> : <p class="help">At least {MIN_PASSWORD_LENGTH} characters. They must change it when they first sign in.</p>}
            </div>
          ) : (
            <div class="self-end">
              <label class="a-check">
                <input type="checkbox" name="active" checked={v.active} disabled={isSelf} />
                Can sign in
              </label>
              {isSelf && <input type="hidden" name="active" value="on" />}
              <p class="help">Untick to deactivate the account without deleting its history.</p>
            </div>
          )
        }
      </div>
      <div class="mt-5 flex gap-2">
        <button class="btn btn-primary" type="submit">{isNew ? 'Create account' : 'Save changes'}</button>
        <a href="/admin/users" class="btn btn-tertiary">Cancel</a>
      </div>
    </form>

    {
      target && !isSelf && (
        <>
          <form method="post" class="a-card a-card-pad">
            <input type="hidden" name="_action" value="reset" />
            <h2 class="a-card-title">Reset password</h2>
            <p class="a-muted">Sets a temporary password, signs {target.name} out everywhere and unlocks the account.</p>
            <div class="mt-3 flex flex-wrap items-end gap-3">
              <div class="min-w-64 flex-1">
                <label class="label" for="reset-password">New temporary password</label>
                <input class="input" id="reset-password" name="password" type="text" autocomplete="off" minlength={MIN_PASSWORD_LENGTH} required />
              </div>
              <button class="btn btn-tertiary" type="submit">Reset password</button>
            </div>
          </form>

          <details class="a-card a-card-pad">
            <summary class="cursor-pointer font-semibold text-danger">Delete this account</summary>
            <p class="mt-2">This permanently removes the account for {target.name}. Their past activity stays in the log without a name. To keep the history, deactivate the account instead.</p>
            <form method="post" class="mt-3">
              <input type="hidden" name="_action" value="delete" />
              <button class="btn btn-danger" type="submit">Delete {target.name}&rsquo;s account</button>
            </form>
          </details>
        </>
      )
    }
    {isSelf && <p class="a-muted">To change your own password, go to <a class="link" href="/admin/account">your account</a>.</p>}
  </div>
</AdminLayout>
