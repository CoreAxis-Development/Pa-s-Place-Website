---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { can } from '../../../server/auth/session';
import { currentUser, deny, setFlash, str } from '../../../server/http/request';
import { formatDateTime } from '../../../server/lib/dates';
import { logActivity } from '../../../server/services/activity';
import { MEDIA_CATEGORIES, deleteMedia, getMedia, mediaUsage, toPicture, updateMedia } from '../../../server/services/media';

const user = currentUser(Astro);
const id = Astro.params.id!;
const here = `/admin/media/${id}`;
const media = await getMedia(id);
if (!media) {
  setFlash(Astro, 'That photo no longer exists.', 'warning');
  return Astro.redirect('/admin/media');
}
const usage = await mediaUsage(id);

if (Astro.request.method === 'POST') {
  const denied = deny(Astro, 'edit', here);
  if (denied) return denied;
  const form = await Astro.request.formData();

  if (str(form, '_action') === 'delete') {
    if (usage.length) {
      setFlash(Astro, 'This photo is still in use. Remove it from those places first.', 'danger');
      return Astro.redirect(here);
    }
    await deleteMedia(id);
    await logActivity({ actorId: user.id, action: 'media.deleted', entityType: 'media', entityId: id, summary: `${user.name} deleted the photo “${media.alt || media.filename}”` });
    setFlash(Astro, 'Photo deleted.');
    return Astro.redirect('/admin/media');
  }

  await updateMedia(id, {
    alt: str(form, 'alt'),
    caption: str(form, 'caption'),
    category: MEDIA_CATEGORIES.find((c) => c.value === str(form, 'category'))?.value ?? media.category,
    needsConsent: form.get('needsConsent') === 'on',
  });
  await logActivity({ actorId: user.id, action: 'media.updated', entityType: 'media', entityId: id, summary: `${user.name} updated the photo “${str(form, 'alt') || media.filename}”` });
  setFlash(Astro, 'Photo details saved.');
  return Astro.redirect(here);
}

const picture = toPicture(media);
const canEdit = can(user, 'edit');
---

<AdminLayout title={media.alt || media.filename} subtitle="Photo details">
  <a slot="breadcrumb" href="/admin/media" class="link">Photos</a>

  <div class="grid gap-5 xl:grid-cols-[1.2fr_1fr]">
    <div class="a-card a-card-pad">
      <img src={picture.src} srcset={picture.srcset} sizes="(min-width: 1280px) 640px, 92vw" width={picture.width} height={picture.height} alt={media.alt} class="h-auto w-full rounded-md" style={`background:${media.color}`} />
      <dl class="a-dl mt-4">
        <div><dt>File</dt><dd>{media.filename}</dd></div>
        <div><dt>Size</dt><dd>{media.width} × {media.height} px · {Math.round(media.bytes / 1024)} KB original</dd></div>
        <div><dt>Web copies</dt><dd>{media.variants.map((v) => `${v.w}px`).join(', ')}</dd></div>
        <div><dt>Added</dt><dd>{formatDateTime(media.createdAt)}</dd></div>
        <div><dt>Used in</dt><dd>{usage.length ? <ul>{usage.map((u) => <li>{u}</li>)}</ul> : <span class="a-muted">Not used anywhere yet</span>}</dd></div>
      </dl>
    </div>

    <div class="grid content-start gap-5">
      <form method="post" class="a-card a-card-pad">
        <fieldset disabled={!canEdit} class="grid gap-4">
          <h2 class="a-card-title">Details</h2>
          {media.needsConsent && <p class="alert alert-warning">This photo is flagged: it shows a recognisable child or third-party artwork. Keep it off the website until consent is on file, then untick the box below.</p>}
          <div>
            <label class="label" for="alt">Description</label>
            <input class="input" id="alt" name="alt" value={media.alt} maxlength="300" />
            <p class="help">Say what is in the photo. Read aloud to people who cannot see it, and used by search engines.</p>
          </div>
          <div>
            <label class="label" for="caption">Caption (optional)</label>
            <input class="input" id="caption" name="caption" value={media.caption} maxlength="300" />
            <p class="help">Shown under the photo. Eight words or fewer.</p>
          </div>
          <div>
            <label class="label" for="category">Category</label>
            <select class="input" id="category" name="category">
              {MEDIA_CATEGORIES.map((c) => <option value={c.value} selected={c.value === media.category}>{c.label}</option>)}
            </select>
          </div>
          <label class="a-check">
            <input type="checkbox" name="needsConsent" checked={media.needsConsent} />
            Consent still needed before this is published
          </label>
          {canEdit && <button class="btn btn-primary justify-self-start" type="submit">Save details</button>}
        </fieldset>
      </form>

      {
        canEdit && (
          <details class="a-card a-card-pad">
            <summary class="cursor-pointer font-semibold text-danger">Delete this photo</summary>
            {
              usage.length ? (
                <p class="mt-2">This photo is in use and cannot be deleted yet. Remove it from the places listed under “Used in” first.</p>
              ) : (
                <>
                  <p class="mt-2">This permanently deletes the photo and its web copies. It cannot be undone.</p>
                  <form method="post" class="mt-3">
                    <input type="hidden" name="_action" value="delete" />
                    <button class="btn btn-danger" type="submit">Delete photo permanently</button>
                  </form>
                </>
              )
            }
          </details>
        )
      }
    </div>
  </div>
</AdminLayout>
