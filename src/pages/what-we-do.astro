---
import Layout from '../layouts/Layout.astro';
import miniGolfInk from '../assets/images/mini-golf-ink.webp';
import MissionBand from '../components/sections/MissionBand.astro';
import PlaySection from '../components/sections/PlaySection.astro';
import Icon from '../components/ui/Icon.astro';
import Picture from '../components/ui/Picture.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { getSite } from '../server/services/content';

const site = await getSite();
const { settings, amenities, homepage } = site;
const photoFor = (icon: string) => amenities.find((a) => a.icon === icon)?.image ?? null;

const work = [
  {
    eyebrow: 'For children',
    title: 'Sponsored seaside holidays',
    text: 'The reason we exist. Children who have never had a seaside holiday come to stay: beach days, the pool and slides, mini-golf, games on the lawn, music and art, and food made together. Each group is looked after closely, with room for the loud hours and the quiet ones.',
    image: photoFor('pool'),
    link: { label: 'Sponsor a child’s holiday', href: '/contact?about=sponsor#enquiry' },
  },
  {
    eyebrow: 'For families and groups',
    title: 'Affordable holidays',
    text: `Comfortable rooms in a big shaded garden, two minutes from the beach, priced so that an ordinary family can get away. ${settings.pricing.accommodation}. What you pay helps fund the children’s holidays.`,
    image: photoFor('tree'),
    link: { label: 'Book a stay', href: '/book-a-stay' },
  },
  {
    eyebrow: 'For celebrations',
    title: 'Venue hire and community days',
    text: `The lapa, pool and lawns are hired out for birthdays, church groups and family days, and opened to local families for food and play days. ${settings.pricing.venue}.`,
    image: photoFor('lapa'),
    link: { label: 'Hire the venue', href: '/venue-hire' },
  },
];

const day = [
  { icon: 'beach', time: 'Early', text: 'A walk to the beach while the sand is still cool.' },
  { icon: 'pool', time: 'Morning', text: 'The pool and slides, then mini-golf in the shade.' },
  { icon: 'braai', time: 'Midday', text: 'Lunch made together and eaten at the lapa.' },
  { icon: 'play', time: 'Afternoon', text: 'Sport, team games and time on the lawn.' },
  { icon: 'heart', time: 'Evening', text: 'Music, art and quiet time before bed.' },
];
---

<Layout title="What we do" description="Pa's Place gives children their first seaside holiday, funded by affordable family stays and venue hire in Pennington, KZN.">
  <section class="coast-masthead" data-coast-art="shore" aria-label="What we do">
    <div class="container-page py-10 lg:py-14">
      <p class="eyebrow">What we do</p>
      <h1 class="t-h1 mt-2 max-w-3xl">One garden, three kinds of work</h1>
      <p class="t-lead mt-4 max-w-[62ch]">
        The sponsored children&rsquo;s holidays are why Pa&rsquo;s Place exists. Family stays and venue hire are how they are paid for.
      </p>
    </div>
  </section>

  <section class="section !pt-12" aria-label="Our work">
    <div class="container-page space-y-16 lg:space-y-24">
      {
        work.map((w, i) => (
          <article class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              {w.image && <Picture image={w.image} sizes="(min-width: 1024px) 540px, 92vw" class="photo aspect-[3/2]" />}
            </div>
            <div>
              <SectionHeader rays={i === 0} eyebrow={w.eyebrow} title={w.title} class="!mb-4" />
              <p class="max-w-[58ch]">{w.text}</p>
              <a href={w.link.href} class="link mt-5 inline-block">{w.link.label}</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <PlaySection id="childrens-holiday" label="A day on a children's holiday">
    <div class="holiday-opening">
      <SectionHeader rays title="A day by the sea" lead="Every group is different. Here’s how a day might go." class="!mb-0" />
      <img src={miniGolfInk.src} width={miniGolfInk.width} height={miniGolfInk.height} alt="" class="holiday-ink" loading="lazy" decoding="async" />
    </div>
    <ol class="holiday-day">
      {
        day.map((d) => (
          <li>
            <span class="holiday-day-icon"><Icon name={d.icon} class="h-6 w-6" /></span>
            <div>
              <h3 class="t-h4">{d.time}</h3>
              <p class="mt-1 text-[0.9375rem]">{d.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </PlaySection>

  <MissionBand title={homepage.missionTitle} text={homepage.missionText} sponsor />
</Layout>

<style>
  .holiday-opening {
    display: grid;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-bottom: 1.5rem;
  }

  .holiday-ink {
    justify-self: end;
    width: clamp(125px, 27vw, 235px);
    height: auto;
    opacity: 0.34;
    mask-image: linear-gradient(145deg, transparent 9%, #000 47%);
  }

  @media (min-width: 640px) {
    .holiday-opening {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .holiday-day {
    --trail: var(--color-pool-700);
    --stop-size: 48px;
    display: grid;
    gap: 1.25rem;
  }

  .holiday-day > li {
    position: relative;
    display: grid;
    grid-template-columns: var(--stop-size) minmax(0, 1fr);
    align-items: start;
    gap: 0.875rem;
  }

  .holiday-day > li:not(:last-child)::before {
    content: "";
    position: absolute;
    top: var(--stop-size);
    bottom: -1.25rem;
    left: calc(var(--stop-size) / 2);
    border-left: 2px dashed var(--trail);
  }

  .holiday-day-icon {
    display: grid;
    width: var(--stop-size);
    height: var(--stop-size);
    place-items: center;
    border: 2px solid var(--trail);
    border-radius: 50%;
    color: var(--trail);
    background: var(--color-raised);
  }

  @media (min-width: 900px) {
    .holiday-day {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .holiday-day > li {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: var(--stop-size) auto;
    }

    .holiday-day > li:not(:last-child)::before {
      top: calc(var(--stop-size) / 2);
      right: -1.25rem;
      bottom: auto;
      left: var(--stop-size);
      border-top: 2px dashed var(--trail);
      border-left: 0;
    }
  }
</style>
