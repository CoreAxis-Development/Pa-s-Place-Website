---
import Layout from '../layouts/Layout.astro';
import BookingEngine from '../components/booking/BookingEngine.tsx';
import { engineProps } from '../components/booking/engine-props';
import Faqs from '../components/sections/Faqs.astro';
import MissionBand from '../components/sections/MissionBand.astro';
import PlaySection from '../components/sections/PlaySection.astro';
import Icon from '../components/ui/Icon.astro';
import Picture from '../components/ui/Picture.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { formatRand } from '../server/lib/pricing';
import { getSite } from '../server/services/content';

const site = await getSite();
const { settings, venuePage, homepage } = site;
const tel = settings.contact.phoneLink || settings.contact.phone;
const venue = site.options.find((o) => o.kind === 'venue');

const steps = [
  { title: 'Send your date', text: 'Choose the day and tell us how many guests. The date is held as soon as you send it.' },
  { title: 'We confirm', text: 'We check the request and confirm with you by phone or email.' },
  { title: 'Pay the deposit', text: `A ${formatRand(settings.booking.venueDeposit)} deposit by EFT secures the day. The balance is settled on the day.` },
];
---

<Layout
  title="Venue hire"
  description={`Hire the lapa, pool, waterslides and gardens at Pa's Place in Pennington, KZN for birthdays and gatherings. ${settings.pricing.venue}.`}
  image={venuePage.image?.src}
>
  <section class="bg-canopy-50" aria-label="Venue hire">
    <div class="container-page grid items-center gap-10 pb-14 pt-10 lg:grid-cols-2 lg:gap-14 lg:pt-14">
      <div>
        <p class="eyebrow">Venue hire</p>
        <h1 class="t-h1 mt-2">{venuePage.title}</h1>
        <p class="t-lead mt-4 max-w-[52ch]">{venuePage.intro}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {settings.pricing.venue && <li class="chip tnum"><Icon name="wallet" />{settings.pricing.venue}</li>}
          {venue?.capacityLabel && <li class="chip tnum"><Icon name="users" />{venue.capacityLabel}</li>}
        </ul>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#book" class="btn btn-primary">Check a date</a>
          <a href="/contact?about=venue#enquiry" class="btn btn-tertiary">Ask a question</a>
        </div>
      </div>
      {venuePage.image && <Picture image={venuePage.image} sizes="(min-width: 1024px) 540px, 92vw" class="photo aspect-[3/2] !rounded-[20px]" eager />}
    </div>
  </section>

  <PlaySection tone="sun" label="What is included">
    <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeader rays eyebrow="What you get" title="Everything for a long, easy day" class="!mb-6" />
        <ul class="ray-list space-y-2.5">
          {venuePage.included.map((item) => <li>{item}</li>)}
        </ul>
        <h3 class="t-h4 mt-8">Good for</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {venuePage.occasions.map((o) => <li class="tag !h-7 !px-2.5 !text-[0.8125rem]">{o}</li>)}
        </ul>
      </div>
      {
        venuePage.secondaryImage && (
          <figure>
            <Picture image={venuePage.secondaryImage} sizes="(min-width: 1024px) 540px, 92vw" class="photo aspect-[4/3]" />
            {venuePage.secondaryImage.caption && <figcaption class="t-caption mt-2">{venuePage.secondaryImage.caption}</figcaption>}
          </figure>
        )
      }
    </div>
  </PlaySection>

  <section class="section" id="book" aria-label="Booking form">
    <div class="container-page">
      <SectionHeader eyebrow="Book the venue" title="Pick your day" />
      {
        venue ? (
          <BookingEngine client:load {...engineProps(site)} kinds={['venue']} defaultOption={venue.slug} />
        ) : (
          <p class="alert alert-info">Online venue booking is not open at the moment. Please call us to book.</p>
        )
      }
      {
        settings.contact.phone && (
          <p class="mt-5 text-center text-[0.9375rem]">
            Rather book by phone? Call {settings.contact.person || 'us'} on <a class="link tnum" href={`tel:${tel}`}>{settings.contact.phone}</a>.
          </p>
        )
      }
    </div>
  </section>

  <section class="section bg-sunken" aria-label="How booking works">
    <div class="container-page">
      <SectionHeader eyebrow="How it works" title="Booking in three steps" />
      <ol class="grid gap-6 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="card card-pad">
              <span class="ring">{i + 1}</span>
              <h3 class="t-h4 mt-4">{s.title}</h3>
              <p class="mt-1.5 text-[0.9375rem]">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-[0.9375rem]">Want to make a weekend of it? <a class="link" href="/book-a-stay">Book a stay as well</a>.</p>
    </div>
  </section>

  <Faqs faqs={site.faqs.filter((f) => f.topic === 'venue')} title="About hiring the venue" />
  <MissionBand title={homepage.missionTitle} text={homepage.missionText} />
</Layout>
