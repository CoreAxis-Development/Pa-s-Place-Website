---
import Layout from '../layouts/Layout.astro';
import Sunrise from '../components/ui/Sunrise.astro';
import EnquiryForm from '../components/sections/EnquiryForm.astro';
import MissionBand from '../components/sections/MissionBand.astro';
import Icon from '../components/ui/Icon.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { getSite } from '../server/services/content';

const { settings, homepage } = await getSite();

const ways = [
  {
    icon: 'heart',
    title: 'Sponsor a child’s holiday',
    text: 'Cover a child’s stay: a bed, meals and every activity. Tell us if you would like your gift to go to a particular group.',
    cta: { label: 'Ask about sponsoring', href: '?about=sponsor#enquiry', variant: 'btn-primary' },
  },
  {
    icon: 'bed',
    title: 'Book a stay',
    text: `Bring your family or group for a holiday. ${settings.pricing.accommodation}. Your booking helps pay for a child’s.`,
    cta: { label: 'Book a stay', href: '/book-a-stay', variant: 'btn-tertiary' },
  },
  {
    icon: 'lapa',
    title: 'Hire the venue',
    text: `Hold your party or gathering here. ${settings.pricing.venue}.`,
    cta: { label: 'Hire the venue', href: '/venue-hire', variant: 'btn-tertiary' },
  },
];

const roles = [
  ['Activity leaders', 'Beach games, mini-golf, team games'],
  ['Carers', 'Looking after a group through the day and night'],
  ['Kitchen hands', 'Cooking for a crowd'],
  ['Admin and communications', 'Bookings, letters and social media'],
  ['Maintenance', 'Gardens, repairs and painting'],
];
---

<Layout title="Get involved" description="Sponsor a child's seaside holiday, volunteer, or support Pa's Place by booking a stay or hiring the venue.">
  <section class="coast-masthead relative overflow-hidden" aria-label="Get involved">
    <Sunrise class="pointer-events-none absolute -right-20 -top-32 h-64 w-64 opacity-20" />
    <div class="container-page relative py-10 lg:py-14">
      <p class="eyebrow">Get involved</p>
      <h1 class="t-h1 mt-2 max-w-3xl">Help send a child to the sea</h1>
      <p class="t-lead mt-4 max-w-[60ch]">There are three ways to help, and two of them are a holiday for you as well.</p>
    </div>
  </section>

  <section class="section !pt-10" aria-label="Ways to help">
    <div class="container-page grid gap-6 md:grid-cols-3">
      {
        ways.map((w) => (
          <article class="card card-pad flex flex-col">
            <Icon name={w.icon} class="h-7 w-7 text-canopy-600" />
            <h2 class="t-h3 mt-4">{w.title}</h2>
            <p class="mt-2 flex-1 text-[0.9375rem]">{w.text}</p>
            <a href={w.cta.href} class:list={['btn mt-6 self-start', w.cta.variant]}>{w.cta.label}</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" data-coast-art="garden" data-coast-wash="leaf" aria-label="Volunteer">
    <div class="container-page grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeader rays eyebrow="Volunteer" title="Lend a hand" lead="Children’s holidays run on many hands. If you have a free weekend, we would like to hear from you." class="!mb-6" />
        <dl class="divide-y divide-line-strong border-y border-line-strong">
          {
            roles.map(([role, blurb]) => (
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
                <dt class="font-semibold text-ink">{role}</dt>
                <dd class="text-[0.9375rem]">{blurb}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <EnquiryForm heading="Tell us how you would like to help" type={Astro.url.searchParams.get('about') ?? 'volunteer'} />
    </div>
  </section>

  <MissionBand title={homepage.missionTitle} text={homepage.missionText} />
</Layout>
