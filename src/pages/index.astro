---
import Layout from '../layouts/Layout.astro';
import Faqs from '../components/sections/Faqs.astro';
import MissionBand from '../components/sections/MissionBand.astro';
import OptionCard from '../components/sections/OptionCard.astro';
import Icon from '../components/ui/Icon.astro';
import Picture from '../components/ui/Picture.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { todaySast } from '../server/lib/dates';
import { getSite } from '../server/services/content';

const site = await getSite();
const { settings, homepage, options, amenities } = site;

const stays = options.filter((o) => o.kind === 'stay');
const today = todaySast();

const pool = amenities.find((amenity) => amenity.icon === 'pool');
const grounds = pool ? [pool, ...amenities.filter((amenity) => amenity.id !== pool.id)] : amenities;
const hero = homepage.heroImage ?? grounds.find((amenity) => amenity.image)?.image;
---

<Layout image={hero?.src}>
  <section class="coast-masthead on-dark" aria-labelledby="home-title">
    <div class="container-page hero-spread">
      <div>
        <p class="eyebrow">{homepage.heroEyebrow}</p>
        <h1 id="home-title" class="coast-display mt-4">{homepage.heroTitle}</h1>
        <p class="t-lead mt-5 max-w-[43ch]">{homepage.heroSubtitle}</p>
        <a href="/book-a-stay#book" class="btn btn-primary mt-7">Check availability</a>
      </div>
      {
        hero && (
          <figure class="coast-print hero-print">
            <Picture image={hero} sizes="(min-width: 1024px) 530px, 92vw" class="aspect-[5/4] w-full object-cover" eager />
            {hero.caption && <figcaption>{hero.caption}</figcaption>}
          </figure>
        )
      }
    </div>
  </section>

  <nav aria-label="Plan your visit" class="coast-route">
    <a href="#stay" style="--route-colour: var(--color-sun-500)"><span>Stay with us</span><Icon name="arrow" /></a>
    <a href="/venue-hire" style="--route-colour: var(--coast-coral)"><span>Have a party</span><Icon name="arrow" /></a>
    <a href={amenities.length > 0 ? '#grounds' : '/gallery'} style="--route-colour: var(--coast-pool)"><span>Explore the grounds</span><Icon name="arrow" /></a>
  </nav>

  {
    amenities.length > 0 && (
      <section id="grounds" class="section grounds" aria-labelledby="grounds-title">
        <div class="container-page">
          <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
            <div>
              <h2 id="grounds-title" class="t-h2">{homepage.groundsTitle}</h2>
              <p class="t-lead mt-3 max-w-[54ch]">{homepage.groundsIntro}</p>
            </div>
            <a href="/gallery" class="btn btn-tertiary">See more photos</a>
          </div>
          <div class:list={['grounds-spread mt-8', amenities.length > 2 && 'grounds-spread-feature']}>
            {
              grounds.map((amenity, index) => (
                <article class="ground-entry">
                  {amenity.image && (
                    <Picture
                      image={amenity.image}
                      sizes={index === 0 ? '(min-width: 1024px) 570px, 92vw' : '(min-width: 1024px) 280px, 46vw'}
                      class="ground-photo w-full object-cover"
                    />
                  )}
                  <h3 class="ground-title">
                    <Icon name={amenity.icon} class="h-5 w-5 shrink-0" />
                    {amenity.title}
                  </h3>
                  <p class="ground-description">{amenity.description}</p>
                </article>
              ))
            }
          </div>
          <a href="/what-we-do#childrens-holiday" class="link mt-7 inline-block">Follow a day on a children&rsquo;s holiday</a>
        </div>
      </section>
    )
  }

  <MissionBand title={homepage.missionTitle} text={homepage.missionText} />

  <section class="section" id="stay" aria-label="Stays">
    <div class="container-page">
      <SectionHeader title="Find your kind of stay" lead="Choose a room or bring everyone and book the whole house." />
      {stays.length > 0 && (
        <details class="quick-book mb-6">
          <summary>Check your dates</summary>
          <form action="/book-a-stay" method="get" class="mt-4" aria-label="Check availability">
            <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:items-end">
              <div class="bar-cell col-span-2 md:col-span-1">
                <label for="hb-option">Stay</label>
                <select id="hb-option" name="option">
                  {stays.map((stay) => <option value={stay.slug}>{stay.name}</option>)}
                </select>
              </div>
              <div class="bar-cell">
                <label for="hb-from">Check-in</label>
                <input id="hb-from" name="from" type="date" min={today} />
              </div>
              <div class="bar-cell">
                <label for="hb-to">Check-out</label>
                <input id="hb-to" name="to" type="date" min={today} />
              </div>
              <div class="bar-cell col-span-2 md:col-span-1">
                <label for="hb-people">People</label>
                <input id="hb-people" name="people" type="number" min="1" max="40" value="4" inputmode="numeric" />
              </div>
            </div>
            <button type="submit" class="btn btn-primary mt-4">Check availability</button>
          </form>
        </details>
      )}
      {stays.length === 0 && <p><a href="/contact?about=stay" class="link">Contact us about staying</a></p>}
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {stays.map((stay) => <OptionCard option={stay} />)}
      </div>
    </div>
  </section>

  <!-- ============ VENUE HIRE ============ -->
  <section class="section bg-sunken" aria-label="Venue hire">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      {homepage.venueImage && <Picture image={homepage.venueImage} sizes="(min-width: 1024px) 540px, 92vw" class="photo aspect-[3/2]" />}
      <div>
        <SectionHeader rays eyebrow="Venue hire" title={homepage.venueTitle} lead={homepage.venueIntro} class="!mb-6" />
        <ul class="ray-list grid gap-2 sm:grid-cols-2">
          {site.venuePage.occasions.map((o) => <li>{o}</li>)}
        </ul>
        {settings.pricing.venue && <p class="mt-6"><span class="tag tag-price !h-auto py-1.5">{settings.pricing.venue}</span></p>}
        <a href="/venue-hire" class="btn btn-secondary mt-6">Hire the venue</a>
      </div>
    </div>
  </section>

  <!-- ============ FINDING US ============ -->
  <section class="section" aria-label="Where to find us">
    <div class="container-page grid items-center gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <SectionHeader eyebrow="Finding us" title="Kelso, Pennington, on the KZN South Coast" class="!mb-4" />
        <p class="flex max-w-xl items-start gap-2.5">
          <Icon name="pin" class="mt-1 h-5 w-5 flex-none text-canopy-600" />
          <span class="whitespace-pre-line">{settings.contact.address}</span>
        </p>
        <p class="mt-2 max-w-xl">About an hour south of Durban, and two minutes on foot from the beach.</p>
      </div>
      <div class="flex flex-wrap gap-3 md:flex-col">
        {settings.contact.mapUrl && <a href={settings.contact.mapUrl} target="_blank" rel="noopener" class="btn btn-tertiary bg-raised">Open the map</a>}
        <a href="/contact" class="btn btn-tertiary bg-raised">Contact us</a>
      </div>
    </div>
  </section>

  <Faqs faqs={site.faqs.filter((f) => f.topic !== 'venue').slice(0, 6)} />
</Layout>

<style>
  .hero-spread {
    display: grid;
    align-items: center;
    gap: clamp(1.8rem, 4vw, 4rem);
    padding-block: clamp(2.2rem, 5vw, 4.8rem);
  }

  .hero-print {
    position: relative;
    min-width: 0;
  }

  .hero-print figcaption {
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    max-width: calc(100% - 0.9rem);
    padding: 0.45rem 0.65rem;
    overflow-wrap: anywhere;
    background: var(--coast-coral);
    color: var(--coast-deep);
    font-size: 0.875rem;
    font-weight: 800;
  }

  .grounds {
    background: var(--coast-pool);
  }

  .grounds-spread {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.8rem, 2.6vw, 1.75rem);
    align-items: start;
  }

  .grounds-spread-feature .ground-entry:first-child {
    grid-column: 1 / -1;
  }

  .ground-entry {
    min-width: 0;
  }

  .ground-entry :global(.ground-photo) {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
  }

  .ground-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    max-width: calc(100% - 0.45rem);
    margin: -0.65rem 0 0 0.45rem;
    padding: 0.3rem 0.55rem;
    position: relative;
    background: var(--color-sun-500);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.25;
    text-wrap: wrap;
  }

  .ground-entry:nth-child(3n + 2) .ground-title {
    background: var(--coast-coral);
  }

  .ground-entry:nth-child(3n + 3) .ground-title {
    background: var(--coast-paper);
  }

  .ground-description {
    margin-top: 0.55rem;
    font-size: 0.9375rem;
  }

  .quick-book {
    border-block: 1px solid var(--color-line);
    background: var(--color-raised);
    padding: 0.75rem clamp(0.75rem, 2vw, 1.25rem);
  }

  .quick-book summary {
    width: fit-content;
    cursor: pointer;
    color: var(--color-canopy-600);
    font-weight: 800;
  }

  .bar-cell {
    min-width: 0;
    display: grid;
    gap: 0.25rem;
  }

  .bar-cell label {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .bar-cell :is(input, select) {
    min-width: 0;
    width: 100%;
    min-height: 44px;
    padding-inline: 0.55rem;
    border: 1px solid var(--color-line-field);
    border-radius: 6px;
    background: white;
    color: var(--color-ink);
    font-size: 1rem;
  }

  @media (min-width: 900px) {
    .hero-spread {
      grid-template-columns: 1.05fr 1fr;
    }

    .hero-print {
      transform: rotate(2deg);
    }

    .grounds-spread-feature {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .grounds-spread-feature .ground-entry:first-child {
      grid-column: auto;
    }

    .grounds-spread-feature .ground-entry:first-child :global(.ground-photo) {
      aspect-ratio: 16 / 10;
    }
  }
</style>

<script>
  // keep check-out after check-in
  const from = document.getElementById('hb-from') as HTMLInputElement | null;
  const to = document.getElementById('hb-to') as HTMLInputElement | null;
  from?.addEventListener('change', () => {
    if (!to || !from.value) return;
    const next = new Date(`${from.value}T00:00:00Z`);
    next.setUTCDate(next.getUTCDate() + 1);
    to.min = next.toISOString().slice(0, 10);
    if (!to.value || to.value <= from.value) to.value = to.min;
  });
</script>
