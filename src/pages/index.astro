---
import Layout from '../layouts/Layout.astro';
import ActivityGuide from '../components/sections/ActivityGuide.astro';
import Faqs from '../components/sections/Faqs.astro';
import OptionCard from '../components/sections/OptionCard.astro';
import Icon from '../components/ui/Icon.astro';
import Picture from '../components/ui/Picture.astro';
import { todaySast } from '../server/lib/dates';
import type { Picture as SitePhoto } from '../server/services/media';
import { getSite } from '../server/services/content';

const site = await getSite();
const { settings, homepage, options, amenities, gallery } = site;
const today = todaySast();

const usedPhotos = new Set<string>();
function takePhoto(...choices: (SitePhoto | null | undefined)[]) {
  const photo = choices.find((choice) => choice && !usedPhotos.has(choice.id));
  if (!photo) return null;
  usedPhotos.add(photo.id);
  return photo;
}

const photosFor = (category: string) => gallery.filter((item) => item.category === category).map((item) => item.image);
const pool = amenities.find((amenity) => amenity.icon === 'pool');
const hero = takePhoto(pool?.image, homepage.heroImage, ...amenities.map((amenity) => amenity.image));
const venuePhoto = takePhoto(homepage.venueImage, ...photosFor('venue'), ...photosFor('celebrations'));
const missionPhoto = takePhoto(homepage.missionImage);
const stays = options.filter((option) => option.kind === 'stay').map((stay) => ({ ...stay, image: takePhoto(stay.image) }));
const secondPhoto = takePhoto(homepage.heroImage, ...photosFor('grounds'));

const amenityCategories: Record<string, string> = {
  pool: 'pool',
  golf: 'mini-golf',
  lapa: 'venue',
  tree: 'grounds',
};
const grounds = amenities.map((amenity) => ({
  ...amenity,
  image: takePhoto(
    amenity.image,
    ...photosFor(amenityCategories[amenity.icon] ?? ''),
    ...(amenity.icon === 'lapa' ? photosFor('celebrations') : []),
  ),
}));
---

<Layout image={hero?.src}>
  <section class="home-masthead" data-coast-art="garden" aria-labelledby="home-title">
    <div class:list={['container-page hero-spread', hero && 'hero-with-photo']}>
      <div>
        <p class="eyebrow">{homepage.heroEyebrow}</p>
        <h1 id="home-title" class="coast-display mt-3">{homepage.heroTitle}</h1>
        <p class="t-lead mt-4 max-w-[42ch]">{homepage.heroSubtitle}</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="/book-a-stay#book" class="btn btn-primary">Check availability</a>
          <a href={amenities.length > 0 ? '#grounds' : '/gallery'} class="link">{amenities.length > 0 ? 'Explore the grounds' : 'See the gallery'}</a>
        </div>
      </div>
      {
        hero && (
          <div class:list={['holiday-photos', secondPhoto && 'holiday-photos-pair']}>
            <figure class="holiday-main">
              <Picture image={hero} sizes="(min-width: 900px) 440px, 84vw" class="holiday-photo" eager />
            </figure>
            {secondPhoto && (
              <figure class="holiday-side">
                <Picture image={secondPhoto} sizes="(min-width: 900px) 185px, 35vw" class="holiday-photo" />
              </figure>
            )}
          </div>
        )
      }
    </div>
  </section>

  <nav aria-label="Plan your visit" class="visit-nav">
    <div class="container-page">
      <div class="coast-route">
        <a href="#stay">
          <Icon name="bed" />
          <span>Find a room<small>Bunks, rooms and whole-house stays</small></span>
        </a>
        <a href={amenities.length > 0 ? '#grounds' : '/gallery'}>
          <Icon name="pool" />
          <span>Things to do<small>Pool, waterslides and mini-golf</small></span>
        </a>
        <a href="/venue-hire#kids-parties">
          <Icon name="lapa" />
          <span>Host a party<small>See the birthday playbook</small></span>
        </a>
      </div>
    </div>
  </nav>

  {grounds.length > 0 && <ActivityGuide amenities={grounds} title={homepage.groundsTitle} intro={homepage.groundsIntro} />}

  <section class="section" id="stay" aria-labelledby="plan-title">
    <div class="container-page">
      <h2 class="t-h2 mb-6" id="plan-title">Come for the day or stay the night</h2>
      <div class="visit-plans">
        <div>
          <h3 class="t-h3">Find a room that fits</h3>
          <p class="mt-2 mb-4 max-w-[44ch]">Bunks, family rooms or the whole house. Choose what suits your group and check your dates.</p>
          {stays.length > 0 && (
            <details class="quick-book mb-6">
              <summary>Check your dates</summary>
              <form action="/book-a-stay" method="get" class="mt-4" aria-label="Check availability">
                <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:items-end">
                  <div class="bar-cell col-span-2 md:col-span-1">
                    <label for="hb-option">Stay</label>
                    <select id="hb-option" name="option">
                      {stays.map((stay) => <option value={stay.slug}>{stay.name}</option>)}
                    </select>
                  </div>
                  <div class="bar-cell">
                    <label for="hb-from">Check-in</label>
                    <input id="hb-from" name="from" type="date" min={today} />
                  </div>
                  <div class="bar-cell">
                    <label for="hb-to">Check-out</label>
                    <input id="hb-to" name="to" type="date" min={today} />
                  </div>
                  <div class="bar-cell col-span-2 md:col-span-1">
                    <label for="hb-people">People</label>
                    <input id="hb-people" name="people" type="number" min="1" max="40" value="4" inputmode="numeric" />
                  </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Check availability</button>
              </form>
            </details>
          )}
          {stays.length === 0 && <p><a href="/contact?about=stay" class="link">Contact us about staying</a></p>}
          <div class="grid gap-3">
            {stays.map((stay) => <OptionCard option={stay} />)}
          </div>
        </div>
        <aside class="day-plan" aria-labelledby="home-venue-title">
          {venuePhoto && <Picture image={venuePhoto} sizes="(min-width: 900px) 440px, 92vw" class="coast-print aspect-[16/10] object-cover" />}
          <div class="day-plan-copy">
            <p class="eyebrow">Day hire</p>
            <h3 class="t-h3 mt-1" id="home-venue-title">{homepage.venueTitle}</h3>
            <p class="mt-2 max-w-[43ch]">{homepage.venueIntro}</p>
            {settings.pricing.venue && <p class="mt-3 tnum font-semibold text-ink">{settings.pricing.venue}</p>}
            <div class="mt-4 flex flex-wrap items-center gap-4">
              <a href="/venue-hire" class="btn btn-secondary">See the venue</a>
              <a href="/venue-hire#kids-parties" class="link">Plan a kids&rsquo; party</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section home-story" data-coast-art="shore" data-coast-wash="sea" aria-labelledby="home-story-title">
    <div class:list={['container-page home-story-spread', missionPhoto && 'has-story-image']}>
      <div>
        <p class="eyebrow">Why Pa&rsquo;s Place exists</p>
        <h2 class="t-h2 mt-2" id="home-story-title">{homepage.missionTitle}</h2>
        <p class="t-lead mt-3 max-w-[51ch]">{homepage.missionText}</p>
        <a class="btn btn-tertiary mt-5 bg-raised" href="/our-story">Read our story</a>
      </div>
      {
        missionPhoto && (
          <figure class="story-preview">
            <Picture image={missionPhoto} sizes="(min-width: 900px) 465px, 92vw" class="coast-print aspect-[16/10] object-cover" />
            {missionPhoto.caption && <figcaption class="t-caption mt-2">{missionPhoto.caption}</figcaption>}
          </figure>
        )
      }
    </div>
  </section>

  <!-- ============ FINDING US ============ -->
  <section class="home-directions" data-coast-wash="sea" aria-labelledby="directions-title">
    <div class="container-page grid items-center gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <h2 id="directions-title" class="t-h3 mb-2">Getting here</h2>
        <p class="flex max-w-xl items-start gap-2.5">
          <Icon name="pin" class="mt-1 h-5 w-5 flex-none text-canopy-600" />
          <span class="whitespace-pre-line">{settings.contact.address}</span>
        </p>
        <p class="mt-2 max-w-xl">In Kelso, Pennington, about an hour south of Durban and a two-minute walk from the beach.</p>
      </div>
      <div class="flex flex-wrap gap-3 md:flex-col">
        {settings.contact.mapUrl && <a href={settings.contact.mapUrl} target="_blank" rel="noopener" class="btn btn-tertiary bg-raised">Get directions</a>}
        <a href="/contact" class="btn btn-tertiary bg-raised">Contact us</a>
      </div>
    </div>
  </section>

  <Faqs faqs={site.faqs.filter((f) => f.topic !== 'venue').slice(0, 6)} />
</Layout>

<style>
  .home-masthead {
    overflow: clip;
    background: var(--color-page);
  }

  .hero-spread {
    display: grid;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.75rem);
    padding-block: clamp(2.1rem, 4.5vw, 4.4rem);
  }

  .holiday-photos {
    position: relative;
    display: grid;
    align-items: end;
    isolation: isolate;
    min-width: 0;
    padding: 0.6rem 0.7rem 0.8rem 0;
  }

  .holiday-photos-pair {
    grid-template-columns: minmax(0, 2.35fr) minmax(0, 1fr);
    gap: clamp(5px, 1.1vw, 12px);
  }

  .holiday-photos::before {
    position: absolute;
    z-index: -1;
    inset: 18% 0 0 8%;
    border-radius: 40% 20% 1.25rem 1.25rem;
    content: "";
    background: var(--color-sunken);
  }

  .holiday-main,
  .holiday-side {
    min-width: 0;
    overflow: hidden;
    border: 3px solid var(--color-raised);
  }

  .holiday-main {
    border-radius: clamp(2rem, 6vw, 6rem) 0.8rem 0.8rem;
  }

  .holiday-side {
    align-self: end;
    margin-bottom: 7%;
    border-radius: 0.85rem 0.85rem 3rem 0.85rem;
  }

  .holiday-photos :global(.holiday-photo) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .holiday-side :global(.holiday-photo) {
    aspect-ratio: 2 / 3;
  }

  .visit-nav {
    border-block: 1px solid var(--color-line);
    background: var(--color-raised);
  }

  .visit-plans,
  .home-story-spread {
    display: grid;
    align-items: start;
    gap: clamp(1.5rem, 5vw, 4.25rem);
  }

  .day-plan {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-sunken);
  }

  .day-plan-copy {
    padding: clamp(1rem, 3vw, 1.65rem);
  }

  .home-story {
    border-block: 1px solid var(--color-line);
  }

  .home-directions {
    padding-block: clamp(1.4rem, 4vw, 3rem);
  }

  @media (min-width: 900px) {
    .visit-plans {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .home-story-spread.has-story-image {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .quick-book {
    border-block: 1px solid var(--color-line);
    background: var(--color-raised);
    padding: 0.75rem clamp(0.75rem, 2vw, 1.25rem);
  }

  .quick-book summary {
    width: fit-content;
    cursor: pointer;
    color: var(--color-canopy-600);
    font-weight: 800;
  }

  .bar-cell {
    min-width: 0;
    display: grid;
    gap: 0.25rem;
  }

  .bar-cell label {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .bar-cell :is(input, select) {
    min-width: 0;
    width: 100%;
    min-height: 44px;
    padding-inline: 0.55rem;
    border: 1px solid var(--color-line-field);
    border-radius: 6px;
    background: white;
    color: var(--color-ink);
    font-size: 1rem;
  }

  @media (min-width: 900px) {
    .hero-with-photo {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
</style>

<script>
  // keep check-out after check-in
  const from = document.getElementById('hb-from') as HTMLInputElement | null;
  const to = document.getElementById('hb-to') as HTMLInputElement | null;
  from?.addEventListener('change', () => {
    if (!to || !from.value) return;
    const next = new Date(`${from.value}T00:00:00Z`);
    next.setUTCDate(next.getUTCDate() + 1);
    to.min = next.toISOString().slice(0, 10);
    if (!to.value || to.value <= from.value) to.value = to.min;
  });
</script>
