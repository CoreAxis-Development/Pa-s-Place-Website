---
import Layout from '../layouts/Layout.astro';
import ActivityGuide from '../components/sections/ActivityGuide.astro';
import Faqs from '../components/sections/Faqs.astro';
import MissionBand from '../components/sections/MissionBand.astro';
import OptionCard from '../components/sections/OptionCard.astro';
import Icon from '../components/ui/Icon.astro';
import Picture from '../components/ui/Picture.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { todaySast } from '../server/lib/dates';
import { getSite } from '../server/services/content';

const site = await getSite();
const { settings, homepage, options, amenities } = site;

const stays = options.filter((o) => o.kind === 'stay');
const today = todaySast();

const pool = amenities.find((amenity) => amenity.icon === 'pool');
const grounds = pool ? [pool, ...amenities.filter((amenity) => amenity.id !== pool.id)] : amenities;
const hero = pool?.image ?? homepage.heroImage ?? grounds.find((amenity) => amenity.image)?.image;
const secondPhoto = [homepage.heroImage, ...grounds.map((amenity) => amenity.image)]
  .find((photo) => photo && photo.id !== hero?.id);
---

<Layout image={hero?.src}>
  <section class="home-masthead" data-coast-art="garden" aria-labelledby="home-title">
    <div class:list={['container-page hero-spread', hero && 'hero-with-photo']}>
      <div>
        <p class="eyebrow">{homepage.heroEyebrow}</p>
        <h1 id="home-title" class="coast-display mt-3">{homepage.heroTitle}</h1>
        <p class="t-lead mt-4 max-w-[42ch]">{homepage.heroSubtitle}</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="/book-a-stay#book" class="btn btn-primary">Check availability</a>
          <a href={amenities.length > 0 ? '#grounds' : '/gallery'} class="link">{amenities.length > 0 ? 'Explore the grounds' : 'See the gallery'}</a>
        </div>
      </div>
      {
        hero && (
          <div class:list={['holiday-photos', secondPhoto && 'holiday-photos-pair']}>
            <figure class="holiday-main">
              <Picture image={hero} sizes="(min-width: 900px) 440px, 84vw" class="holiday-photo" eager />
            </figure>
            {secondPhoto && (
              <figure class="holiday-side">
                <Picture image={secondPhoto} sizes="(min-width: 900px) 185px, 35vw" class="holiday-photo" />
              </figure>
            )}
          </div>
        )
      }
    </div>
  </section>

  <nav aria-label="Plan your visit" class="visit-nav">
    <div class="container-page">
      <div class="coast-route">
        <a href="#stay">
          <Icon name="bed" />
          <span>Find a room<small>Come solo or bring your crew</small></span>
        </a>
        <a href={amenities.length > 0 ? '#grounds' : '/gallery'}>
          <Icon name="pool" />
          <span>Find the fun<small>Slides, mini-golf and lawn games</small></span>
        </a>
        <a href="/venue-hire#kids-parties">
          <Icon name="lapa" />
          <span>Host a party<small>See the birthday playbook</small></span>
        </a>
      </div>
    </div>
  </nav>

  {grounds.length > 0 && <ActivityGuide amenities={grounds} title={homepage.groundsTitle} intro={homepage.groundsIntro} />}

  <section class="section" id="stay" aria-label="Stays">
    <div class="container-page">
      <SectionHeader title="A place to drop your bags" lead="Travelling light or bringing everyone? Pick a simple room for your South Coast stopover or book the whole house for your group." />
      {stays.length > 0 && (
        <details class="quick-book mb-6">
          <summary>Check your dates</summary>
          <form action="/book-a-stay" method="get" class="mt-4" aria-label="Check availability">
            <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:items-end">
              <div class="bar-cell col-span-2 md:col-span-1">
                <label for="hb-option">Stay</label>
                <select id="hb-option" name="option">
                  {stays.map((stay) => <option value={stay.slug}>{stay.name}</option>)}
                </select>
              </div>
              <div class="bar-cell">
                <label for="hb-from">Check-in</label>
                <input id="hb-from" name="from" type="date" min={today} />
              </div>
              <div class="bar-cell">
                <label for="hb-to">Check-out</label>
                <input id="hb-to" name="to" type="date" min={today} />
              </div>
              <div class="bar-cell col-span-2 md:col-span-1">
                <label for="hb-people">People</label>
                <input id="hb-people" name="people" type="number" min="1" max="40" value="4" inputmode="numeric" />
              </div>
            </div>
            <button type="submit" class="btn btn-primary mt-4">Check availability</button>
          </form>
        </details>
      )}
      {stays.length === 0 && <p><a href="/contact?about=stay" class="link">Contact us about staying</a></p>}
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {stays.map((stay) => <OptionCard option={stay} />)}
      </div>
    </div>
  </section>

  <!-- ============ VENUE HIRE ============ -->
  <section class="section" data-coast-wash="sand" aria-label="Venue hire">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      {homepage.venueImage && <Picture image={homepage.venueImage} sizes="(min-width: 1024px) 540px, 92vw" class="photo aspect-[3/2]" />}
      <div>
        <SectionHeader rays eyebrow="Venue hire" title={homepage.venueTitle} lead={homepage.venueIntro} class="!mb-6" />
        <ul class="ray-list grid gap-2 sm:grid-cols-2">
          {site.venuePage.occasions.map((o) => <li>{o}</li>)}
        </ul>
        {settings.pricing.venue && <p class="mt-6"><span class="tag tag-price !h-auto py-1.5">{settings.pricing.venue}</span></p>}
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a href="/venue-hire" class="btn btn-secondary">Hire the venue</a>
          <a href="/venue-hire#kids-parties" class="link">Plan a kids&rsquo; party</a>
        </div>
      </div>
    </div>
  </section>

  <MissionBand title={homepage.missionTitle} text={homepage.missionText} />

  <!-- ============ FINDING US ============ -->
  <section class="section" data-coast-art="shore" data-coast-wash="sea" aria-label="Where to find us">
    <div class="container-page grid items-center gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <SectionHeader eyebrow="Finding us" title="Kelso, Pennington, on the KZN South Coast" class="!mb-4" />
        <p class="flex max-w-xl items-start gap-2.5">
          <Icon name="pin" class="mt-1 h-5 w-5 flex-none text-canopy-600" />
          <span class="whitespace-pre-line">{settings.contact.address}</span>
        </p>
        <p class="mt-2 max-w-xl">About an hour south of Durban, and two minutes on foot from the beach.</p>
      </div>
      <div class="flex flex-wrap gap-3 md:flex-col">
        {settings.contact.mapUrl && <a href={settings.contact.mapUrl} target="_blank" rel="noopener" class="btn btn-tertiary bg-raised">Open the map</a>}
        <a href="/contact" class="btn btn-tertiary bg-raised">Contact us</a>
      </div>
    </div>
  </section>

  <Faqs faqs={site.faqs.filter((f) => f.topic !== 'venue').slice(0, 6)} />
</Layout>

<style>
  .home-masthead {
    overflow: clip;
    background: var(--color-page);
  }

  .hero-spread {
    display: grid;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.75rem);
    padding-block: clamp(2.1rem, 4.5vw, 4.4rem);
  }

  .holiday-photos {
    position: relative;
    display: grid;
    align-items: end;
    isolation: isolate;
    min-width: 0;
    padding: 0.6rem 0.7rem 0.8rem 0;
  }

  .holiday-photos-pair {
    grid-template-columns: minmax(0, 2.35fr) minmax(0, 1fr);
    gap: clamp(5px, 1.1vw, 12px);
  }

  .holiday-photos::before {
    position: absolute;
    z-index: -1;
    inset: 18% 0 0 8%;
    border-radius: 40% 20% 1.25rem 1.25rem;
    content: "";
    background: var(--color-sunken);
  }

  .holiday-main,
  .holiday-side {
    min-width: 0;
    overflow: hidden;
    border: 3px solid var(--color-raised);
  }

  .holiday-main {
    border-radius: clamp(2rem, 6vw, 6rem) 0.8rem 0.8rem;
  }

  .holiday-side {
    align-self: end;
    margin-bottom: 7%;
    border-radius: 0.85rem 0.85rem 3rem 0.85rem;
  }

  .holiday-photos :global(.holiday-photo) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .holiday-side :global(.holiday-photo) {
    aspect-ratio: 2 / 3;
  }

  .visit-nav {
    border-block: 1px solid var(--color-line);
    background: var(--color-raised);
  }

  .quick-book {
    border-block: 1px solid var(--color-line);
    background: var(--color-raised);
    padding: 0.75rem clamp(0.75rem, 2vw, 1.25rem);
  }

  .quick-book summary {
    width: fit-content;
    cursor: pointer;
    color: var(--color-canopy-600);
    font-weight: 800;
  }

  .bar-cell {
    min-width: 0;
    display: grid;
    gap: 0.25rem;
  }

  .bar-cell label {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .bar-cell :is(input, select) {
    min-width: 0;
    width: 100%;
    min-height: 44px;
    padding-inline: 0.55rem;
    border: 1px solid var(--color-line-field);
    border-radius: 6px;
    background: white;
    color: var(--color-ink);
    font-size: 1rem;
  }

  @media (min-width: 900px) {
    .hero-with-photo {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
</style>

<script>
  // keep check-out after check-in
  const from = document.getElementById('hb-from') as HTMLInputElement | null;
  const to = document.getElementById('hb-to') as HTMLInputElement | null;
  from?.addEventListener('change', () => {
    if (!to || !from.value) return;
    const next = new Date(`${from.value}T00:00:00Z`);
    next.setUTCDate(next.getUTCDate() + 1);
    to.min = next.toISOString().slice(0, 10);
    if (!to.value || to.value <= from.value) to.value = to.min;
  });
</script>
