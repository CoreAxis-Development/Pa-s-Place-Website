---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import MissionBand from '../components/sections/MissionBand.astro';
import Icon from '../components/ui/Icon.astro';
import Picture from '../components/ui/Picture.astro';
import firstSea from '../assets/images/story/hero-first-sea.webp';
import { getSite } from '../server/services/content';

const { homepage, amenities } = await getSite();
const garden = amenities.find((amenity) => amenity.icon === 'tree' && amenity.image)?.image ?? homepage.heroImage;
---

<Layout
  title="Our story"
  description="How stays and celebrations at Pa's Place in Pennington, KZN help give children their first seaside holiday."
  image={garden?.src}
>
  <section class="coast-masthead on-dark" aria-labelledby="story-title">
    <div class="container-page story-spread">
      <div>
        <p class="eyebrow">Our story</p>
        <h1 id="story-title" class="coast-display mt-4">A first look at the sea</h1>
        <p class="t-lead mt-5 max-w-[43ch]">
          Pa&rsquo;s Place is a non-profit in Kelso, Pennington. We give children who have never had a
          seaside holiday the chance to have their first.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#first-holiday" class="btn btn-primary">Come along for the first day</a>
          <a href="/get-involved" class="btn btn-on-dark">Get involved</a>
        </div>
      </div>
      <figure class="coast-print story-print">
        <Image
          src={firstSea}
          alt="A grandfather and child approach the sea hand in hand"
          widths={[480, 760, 1080]}
          sizes="(min-width: 900px) 480px, 92vw"
          class="aspect-[5/4] w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>Illustration of a first seaside holiday</figcaption>
      </figure>
    </div>
  </section>

  <section id="first-holiday" class="section first-day" aria-labelledby="first-day-title">
    <div class="container-page">
      <h2 id="first-day-title" class="t-h2 max-w-[28ch]">What would you notice first?</h2>
      <p class="t-lead mt-3 max-w-[55ch]">Pack your favourite cap. There&rsquo;s a whole day ahead of us.</p>
      <ol class="first-day-list mt-8">
        <li>
          <Icon name="beach" />
          <h3 class="t-h3">Hear the waves</h3>
          <p>Follow the sound down to the beach. Can you spot anything moving in a rock pool?</p>
        </li>
        <li>
          <Icon name="pool" />
          <h3 class="t-h3">Make a splash</h3>
          <p>Back at the garden, there are waterslides to race down and mini-golf to try in the shade.</p>
        </li>
        <li>
          <Icon name="heart" />
          <h3 class="t-h3">Make something together</h3>
          <p>Some days bring music, art or cooking together. There&rsquo;s time to slow down, too.</p>
        </li>
      </ol>
      <a href="/what-we-do#childrens-holiday" class="link mt-7 inline-block">See the whole day</a>
    </div>
  </section>

  <section class="section" aria-labelledby="support-title">
    <div class:list={['container-page grid items-center gap-8 lg:gap-14', garden && 'lg:grid-cols-2']}>
      {
        garden && (
          <figure class="coast-print garden-print">
            <Picture image={garden} sizes="(min-width: 1024px) 510px, 92vw" class="aspect-[4/3] w-full object-cover" />
            <figcaption>Pa&rsquo;s Place in Kelso, Pennington</figcaption>
          </figure>
        )
      }
      <div class="max-w-[52ch]">
        <h2 id="support-title" class="t-h2">How the holidays happen</h2>
        <p class="t-lead mt-4">
          Sponsors and paying guests help fund the children&rsquo;s holidays. When you come for a family
          stay or hire the lapa for a celebration, you help make the next trip possible.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a href="/book-a-stay" class="btn btn-secondary">Book a stay</a>
          <a href="/venue-hire" class="link">Hire the venue</a>
        </div>
      </div>
    </div>
  </section>

  <MissionBand title="Help a child get to the sea" text="A sponsorship helps cover a child’s stay, meals and activities." sponsor moreHref="/get-involved" moreLabel="More ways to help" />
</Layout>

<style>
  .story-spread {
    display: grid;
    align-items: center;
    gap: clamp(1.7rem, 5vw, 5rem);
    padding-block: clamp(2.2rem, 5vw, 4.8rem);
  }

  .story-print figcaption,
  .garden-print figcaption {
    padding: 0.55rem 0.3rem 0.2rem;
    color: var(--color-ink-muted);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .garden-print {
    border-color: var(--coast-sand);
    background: var(--coast-sand);
  }

  .first-day {
    background: var(--coast-pool);
  }

  .first-day-list {
    display: grid;
    gap: clamp(1.2rem, 3vw, 2rem);
  }

  .first-day-list > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-content: start;
    column-gap: 0.8rem;
    row-gap: 0.45rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-pool-700);
  }

  .first-day-list li > :global(svg) {
    width: 2rem;
    height: 2rem;
    color: var(--coast-deep);
  }

  .first-day-list p {
    grid-column: 2;
  }

  @media (min-width: 760px) {
    .first-day-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .story-spread {
      grid-template-columns: 1.12fr 1fr;
    }

    .story-print {
      transform: rotate(-2deg);
    }
  }
</style>
