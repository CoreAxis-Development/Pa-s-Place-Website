---
import Layout from '../layouts/Layout.astro';
import BookingEngine from '../components/booking/BookingEngine.tsx';
import { engineProps } from '../components/booking/engine-props';
import Faqs from '../components/sections/Faqs.astro';
import MissionBand from '../components/sections/MissionBand.astro';
import Icon from '../components/ui/Icon.astro';
import Picture from '../components/ui/Picture.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { getSite } from '../server/services/content';

const site = await getSite();
const { settings, stayPage, homepage } = site;
const tel = settings.contact.phoneLink || settings.contact.phone;

const steps = [
  { title: 'Send your request', text: 'Choose your dates and party size. Your dates are held as soon as you send it.' },
  { title: 'We confirm', text: 'We check the request and confirm with you by phone or email.' },
  { title: 'Pay the deposit', text: `Pay the ${settings.booking.stayDepositPercent}% deposit by EFT. The balance is paid on arrival.` },
];
---

<Layout
  title="Book a stay"
  description={`Book affordable family accommodation in Pennington, KZN. ${settings.pricing.accommodation}. Pool, waterslides and mini-golf included.`}
  image={stayPage.image?.src}
>
  <section class="bg-page" aria-label="Book a stay">
    <div class="container-page pb-8 pt-10 lg:pt-14">
      <p class="eyebrow">Accommodation</p>
      <h1 class="t-h1 mt-2">{stayPage.title}</h1>
      <p class="t-lead mt-4 max-w-[60ch]">{stayPage.intro}</p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {settings.pricing.accommodation && <li class="chip tnum"><Icon name="wallet" />{settings.pricing.accommodation}</li>}
        <li class="chip tnum"><Icon name="clock" />Check-in from {settings.booking.checkIn}, check-out by {settings.booking.checkOut}</li>
      </ul>
    </div>
  </section>

  <section class="bg-page pb-16" id="book" aria-label="Booking form">
    <div class="container-page">
      <BookingEngine client:load {...engineProps(site)} kinds={['stay']} />
      {
        settings.contact.phone && (
          <p class="mt-5 text-center text-[0.9375rem]">
            Rather book by phone? Call {settings.contact.person || 'us'} on{' '}
            <a class="link tnum" href={`tel:${tel}`}>{settings.contact.phone}</a>
            {site.whatsappUrl && <>, or <a class="link" href={site.whatsappUrl} rel="noopener">send a WhatsApp</a></>}.
          </p>
        )
      }
      <noscript>
        <p class="alert alert-info mt-5">
          The booking calendar needs JavaScript. You can still book by phone on {settings.contact.phone}, or <a class="link" href="/contact?about=stay">send us a message</a>.
        </p>
      </noscript>
    </div>
  </section>

  <section class="section bg-sunken" aria-label="What is included">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      {stayPage.image && <Picture image={stayPage.image} sizes="(min-width: 1024px) 540px, 92vw" class="photo aspect-[3/2]" />}
      <div>
        <SectionHeader rays eyebrow="Included in every stay" title="The whole garden is yours" class="!mb-6" />
        <ul class="ray-list space-y-2.5">
          {stayPage.included.map((item) => <li>{item}</li>)}
        </ul>
        <p class="mt-6 text-[0.9375rem]">Hosting a party instead? <a class="link" href="/venue-hire">Hire the venue for the day</a>.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-label="How booking works">
    <div class="container-page">
      <SectionHeader eyebrow="How it works" title="Booking in three steps" />
      <ol class="grid gap-6 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="card card-pad">
              <span class="ring">{i + 1}</span>
              <h3 class="t-h4 mt-4">{s.title}</h3>
              <p class="mt-1.5 text-[0.9375rem]">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Faqs faqs={site.faqs.filter((f) => f.topic === 'stays')} title="About staying with us" />
  <MissionBand title={homepage.missionTitle} text={homepage.missionText} />
</Layout>
