---
import { Image } from 'astro:assets';
import logo from '../assets/brand/pas-place-logo.png';
import coastInk from '../assets/images/footer-coast-ink.webp';
import Dove from './story/Dove.astro';
import { getSite } from '../server/services/content';

const { settings, whatsappUrl } = await getSite();
const { contact, organisation, social } = settings;
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Plan a visit',
    links: [
      { label: 'Book a stay', href: '/book-a-stay' },
      { label: 'Venue hire', href: '/venue-hire' },
      { label: 'Gallery', href: '/gallery' },
    ],
  },
  {
    title: 'About us',
    links: [
      { label: 'Our story', href: '/our-story' },
      { label: 'What we do', href: '/what-we-do' },
      { label: 'Get involved', href: '/get-involved' },
    ],
  },
];
---

<footer class="site-footer on-dark bg-canopy-900 text-on-dark">
  <div class="footer-horizon" aria-hidden="true">
    <div class="footer-scene">
      <img src={coastInk.src} width={coastInk.width} height={coastInk.height} alt="" loading="lazy" decoding="async" />
      <Dove class="footer-dove" />
    </div>
  </div>
  <div class="container-page">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" class="footer-home" aria-label="Pa’s Place homepage">
          <Image src={logo} alt="" widths={[96, 144]} sizes="48px" class="h-12 w-12 object-contain" />
          <span>{settings.siteName}</span>
        </a>
        <p class="text-on-dark-muted">Family stays and venue hire in Kelso, Pennington.</p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        {
          columns.map((column) => (
            <div>
              <h2 class="footer-title">{column.title}</h2>
              <ul class="footer-links">
                {column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
              </ul>
            </div>
          ))
        }
      </nav>

      <div class="footer-contact">
        <h2 class="footer-title">Get in touch</h2>
        <ul class="footer-links">
          {
            contact.phone && (
              <li>
                <a class="tnum" href={`tel:${contact.phoneLink || contact.phone}`}>{contact.phone}</a>
                {contact.person && <span class="text-on-dark-muted"> · ask for {contact.person}</span>}
              </li>
            )
          }
          {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
          <li class="footer-contact-actions">
            {whatsappUrl && <a href={whatsappUrl} rel="noopener">WhatsApp</a>}
            <a href="/contact">Contact page</a>
          </li>
        </ul>
        {
          (contact.address || contact.mapUrl) && (
            <address class="footer-address text-on-dark-muted">
              {contact.address && <span class="whitespace-pre-line">{contact.address}</span>}
              {contact.mapUrl && <a href={contact.mapUrl} target="_blank" rel="noopener" class="footer-map">Get directions</a>}
            </address>
          )
        }
      </div>
    </div>

    <div class="footer-bottom text-on-dark-muted">
      <p>
        &copy; {`${year} ${organisation.legalName}`}
        {organisation.registration && <span> · Reg. no. {organisation.registration}</span>}
      </p>
      <nav aria-label="Footer utility" class="footer-utilities">
        {social.facebook && <a href={social.facebook} target="_blank" rel="noopener">Facebook</a>}
        {social.instagram && <a href={social.instagram} target="_blank" rel="noopener">Instagram</a>}
        <a href="/privacy">Privacy</a>
        <a href="/admin">Staff sign-in</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-tide-height: clamp(1.25rem, 2.75vw, 3.25rem);
    position: relative;
    isolation: isolate;
    padding-block: clamp(2rem, 3.8vw, 3.75rem) 1.15rem;
    font-size: 0.9375rem;
  }

  .site-footer::before,
  .site-footer::after {
    position: absolute;
    z-index: -1;
    inset: auto 0 calc(100% - 1px);
    height: var(--footer-tide-height);
    border-radius: 68% 44% 0 0 / 100% 78% 0 0;
    background: var(--color-canopy-900);
    pointer-events: none;
    content: "";
  }

  .site-footer::before {
    height: calc(var(--footer-tide-height) + 0.55rem);
    opacity: 0.14;
  }

  @supports (clip-path: shape(from 0 0, line to 100% 100%, close)) {
    .site-footer::before,
    .site-footer::after {
      border-radius: 0;
      clip-path: shape(from 0 66%, curve to 58% 62% with 24% -40% / 42% 112%,
        curve to 100% 14% with 73% 22% / 88% -8%, line to 100% 100%, line to 0 100%, close);
    }
  }

  .footer-main,
  .footer-nav {
    display: grid;
    gap: 1.4rem 1.25rem;
  }

  .footer-main > *,
  .footer-nav > * {
    min-width: 0;
  }

  .footer-nav {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .footer-home {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-on-dark);
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.16;
  }

  .footer-home :global(img) {
    flex: none;
  }

  .footer-brand p {
    margin-top: 0.55rem;
    max-width: 24ch;
  }

  .footer-title {
    color: var(--color-on-dark);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 750;
  }

  .footer-links {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .footer-contact-actions,
  .footer-utilities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.85rem;
  }

  .footer-address {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.7rem;
    font-style: normal;
  }

  .footer-contact,
  .footer-bottom {
    overflow-wrap: anywhere;
  }

  .site-footer a {
    text-underline-offset: 0.22em;
  }

  .site-footer a:hover,
  .footer-map {
    text-decoration: underline;
  }

  .footer-horizon {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .footer-scene {
    position: absolute;
    inset: auto 0 0 auto;
    width: clamp(34rem, 88vw, 92rem);
    opacity: 0.48;
    mask-image: linear-gradient(145deg, transparent 16%, rgb(0 0 0 / 0.26) 52%, #000 86%);
  }

  .footer-scene img {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer-scene :global(.footer-dove) {
    position: absolute;
    bottom: 45%;
    right: 20%;
    width: clamp(1.5rem, 2.75vw, 2.35rem);
    height: auto;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 1.75rem;
    margin-top: clamp(2rem, 5vw, 4.5rem);
    padding-top: 0.75rem;
    background: linear-gradient(to right, rgb(255 255 255 / 0.18), transparent 78%) top / 100% 1px no-repeat;
    font-size: 0.8125rem;
  }

  @media (max-width: 639px) {
    .footer-scene {
      opacity: 0.28;
    }
  }

  @media (min-width: 640px) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 960px) {
    .footer-main {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 2rem;
    }

    .footer-brand {
      grid-column: auto;
    }
  }
</style>
