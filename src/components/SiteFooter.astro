---
import { Image } from 'astro:assets';
import logo from '../assets/brand/pas-place-logo.png';
import Sunrise from './ui/Sunrise.astro';
import { getSite } from '../server/services/content';

const { settings, whatsappUrl } = await getSite();
const { contact, organisation, social } = settings;
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Visit',
    links: [
      { label: 'Book a stay', href: '/book-a-stay' },
      { label: 'Venue hire', href: '/venue-hire' },
      { label: 'Gallery', href: '/gallery' },
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'Our story', href: '/our-story' },
      { label: 'What we do', href: '/what-we-do' },
      { label: 'Get involved', href: '/get-involved' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
---

<footer class="on-dark relative overflow-hidden bg-canopy-900 text-on-dark">
  <Sunrise class="pointer-events-none absolute -right-36 -top-36 h-[360px] w-[360px]" />
  <div class="container-page relative pb-8 pt-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_0.8fr_0.8fr_1.3fr]">
      <div>
        <div class="flex items-center gap-3">
          <Image src={logo} alt="" widths={[112, 168]} sizes="56px" class="h-14 w-14 object-contain" />
          <span class="wordmark text-2xl">Pa&rsquo;s Place</span>
        </div>
        <p class="mt-5 max-w-xs text-[0.9375rem] text-on-dark-muted">
          A family holiday garden and party venue in Pennington. Every stay helps give a child their first holiday by
          the sea.
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <h2 class="foot-title">{col.title}</h2>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a class="foot-link" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <h2 class="foot-title">Contact</h2>
        <ul class="mt-4 space-y-2.5">
          {
            contact.phone && (
              <li>
                <a class="foot-link tnum" href={`tel:${contact.phoneLink || contact.phone}`}>
                  {contact.phone}
                </a>
                {contact.person && <span class="text-on-dark-muted"> &middot; ask for {contact.person}</span>}
              </li>
            )
          }
          {
            whatsappUrl && (
              <li>
                <a class="foot-link" href={whatsappUrl} rel="noopener">
                  WhatsApp us
                </a>
              </li>
            )
          }
          {
            contact.email && (
              <li>
                <a class="foot-link" href={`mailto:${contact.email}`}>
                  {contact.email}
                </a>
              </li>
            )
          }
          {contact.address && <li class="whitespace-pre-line text-on-dark-muted">{contact.address}</li>}
          {
            contact.mapUrl && (
              <li>
                <a class="foot-link" href={contact.mapUrl} target="_blank" rel="noopener">
                  Open the map
                </a>
              </li>
            )
          }
          {
            social.facebook && (
              <li>
                <a class="foot-link" href={social.facebook} target="_blank" rel="noopener">
                  Facebook
                </a>
              </li>
            )
          }
          {
            social.instagram && (
              <li>
                <a class="foot-link" href={social.instagram} target="_blank" rel="noopener">
                  Instagram
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-on-dark/15 pt-6 text-[0.8125rem] text-on-dark-muted"
    >
      <p>
        &copy; {year}
        {organisation.legalName}
        {organisation.registration && <span> &middot; Reg. no. {organisation.registration}</span>}
      </p>
      <p class="flex gap-5">
        <a class="hover:text-on-dark hover:underline" href="/privacy">Privacy</a>
        <a class="hover:text-on-dark hover:underline" href="/admin">Staff sign-in</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
  }
  .foot-title {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
  }
  .foot-link {
    color: var(--color-on-dark);
    text-underline-offset: 3px;
  }
  .foot-link:hover {
    text-decoration: underline;
  }
</style>
