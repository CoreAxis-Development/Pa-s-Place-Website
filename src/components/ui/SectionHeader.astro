---
// Ray mark, eyebrow, heading, optional lead. Left-aligned by default.
import RayMark from './RayMark.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  rays?: boolean;
  center?: boolean;
  as?: 'h1' | 'h2';
  class?: string;
}
const { eyebrow, title, lead, rays = false, center = false, as: Tag = 'h2', class: className } = Astro.props;
---

<div class:list={['mb-10 max-w-3xl', center && 'mx-auto text-center', className]}>
  {rays && <RayMark class:list={['mb-3', center && 'mx-auto']} />}
  {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
  <Tag class={Tag === 'h1' ? 't-h1' : 't-h2'}>{title}</Tag>
  {lead && <p class:list={['t-lead mt-3 max-w-[60ch]', center && 'mx-auto']}>{lead}</p>}
</div>
