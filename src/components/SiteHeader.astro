---
// Solid white, sticky, the same on every page. Booking is always one tap away.
import { Image } from 'astro:assets';
import logo from '../assets/brand/pas-place-logo.png';
import Icon from './ui/Icon.astro';
import { getSite } from '../server/services/content';

const { settings } = await getSite();

const links = [
  { label: 'Stay', href: '/book-a-stay' },
  { label: 'Venue hire', href: '/venue-hire' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'What we do', href: '/what-we-do' },
  { label: 'Our story', href: '/our-story' },
  { label: 'Get involved', href: '/get-involved' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header id="site-header" class="sticky top-0 z-50 border-b border-line bg-raised transition-shadow duration-150">
  <div class="container-page relative flex h-[60px] items-center justify-between gap-6 md:h-[68px]">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label="Pa's Place, home">
      <span class="grid h-11 w-11 place-items-center rounded-full bg-canopy-900">
        <Image src={logo} alt="" widths={[80, 120]} sizes="40px" class="h-10 w-10 object-contain" loading="eager" />
      </span>
      <span class="leading-none">
        <span class="wordmark block text-[1.375rem] text-ink">Pa&rsquo;s Place</span>
        <span class="mt-1 block text-[0.6875rem] font-semibold tracking-[0.06em] text-ink-muted">Pennington &middot; Non-profit company</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} class="navlink text-[0.9375rem] font-semibold" aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      {
        settings.contact.phone && (
          <a
            href={`tel:${settings.contact.phoneLink || settings.contact.phone}`}
            class="tnum hidden items-center gap-2 text-[0.9375rem] font-semibold text-canopy-600 hover:text-canopy-700 xl:flex"
          >
            <Icon name="phone" class="h-4 w-4" />
            {settings.contact.phone}
          </a>
        )
      }
      <a href="/book-a-stay" class="btn btn-primary btn-sm">Book a stay</a>
    </div>

    <!-- mobile menu: a checkbox toggle, so it works without JavaScript -->
    <input type="checkbox" id="nav-toggle" class="peer sr-only" aria-label="Open the menu" />
    <label
      for="nav-toggle"
      class="grid h-11 w-11 cursor-pointer place-items-center rounded-[10px] text-ink hover:bg-sunken peer-focus-visible:outline-2 peer-focus-visible:outline-canopy-600 lg:hidden"
    >
      <Icon name="menu" class="h-6 w-6" />
    </label>

    <div class="absolute inset-x-0 top-full hidden border-b border-line bg-raised shadow-lg peer-checked:block lg:!hidden">
      <nav class="container-page flex flex-col py-3" aria-label="Mobile">
        {
          links.map((l) => (
            <a href={l.href} class="flex h-12 items-center border-b border-line font-semibold text-ink" aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
        <a href="/contact" class="flex h-12 items-center font-semibold text-ink">Contact</a>
        <div class="mt-3 grid gap-3 pb-2">
          <a href="/book-a-stay" class="btn btn-primary">Book a stay</a>
          <a href="/venue-hire" class="btn btn-secondary">Hire the venue</a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
  }
  .navlink {
    color: var(--color-ink-body);
    padding-block: 8px;
    border-bottom: 2px solid transparent;
    transition:
      color 120ms,
      border-color 120ms;
  }
  .navlink:hover {
    color: var(--color-ink);
  }
  .navlink[aria-current='page'] {
    color: var(--color-ink);
    border-bottom-color: var(--color-sun-500);
  }
  #site-header.is-scrolled {
    box-shadow: var(--shadow-sm);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
