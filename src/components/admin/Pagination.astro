---
// Previous / next links that keep the current filters in the query string.
interface Props {
  page: number;
  perPage: number;
  total: number;
}
const { page, perPage, total } = Astro.props;
const pages = Math.max(1, Math.ceil(total / perPage));
const link = (p: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  if (p <= 1) q.delete('page');
  else q.set('page', String(p));
  const s = q.toString();
  return `${Astro.url.pathname}${s ? `?${s}` : ''}`;
};
const from = total === 0 ? 0 : (page - 1) * perPage + 1;
const to = Math.min(total, page * perPage);
---

<div class="mt-3 flex flex-wrap items-center justify-between gap-3">
  <p class="a-muted">{total === 0 ? 'Nothing to show' : `Showing ${from} to ${to} of ${total}`}</p>
  {
    pages > 1 && (
      <nav class="flex items-center gap-2" aria-label="Pages">
        {page > 1 ? <a class="btn btn-tertiary btn-sm" href={link(page - 1)}>Previous</a> : <span class="btn btn-tertiary btn-sm" aria-disabled="true">Previous</span>}
        <span class="a-muted px-1">Page {page} of {pages}</span>
        {page < pages ? <a class="btn btn-tertiary btn-sm" href={link(page + 1)}>Next</a> : <span class="btn btn-tertiary btn-sm" aria-disabled="true">Next</span>}
      </nav>
    )
  }
</div>
