---
import { Image } from 'astro:assets';
import fieldGuide from '../../assets/images/grounds-field-guide.webp';

const finds = [
  { id: 'tree', label: 'The big tree on the main lawn' },
  { id: 'flag', label: 'A flag on the mini-golf course' },
  { id: 'slide', label: 'A waterslide' },
  { id: 'shell', label: 'A shell on the beach' },
];
---

<spot-it-trail id="spot-it-trail" class="trail">
  <Image
    src={fieldGuide}
    alt=""
    widths={[360, 600, 800]}
    sizes="(min-width: 900px) 400px, 90vw"
    loading="lazy"
    class="trail-art"
  />
  <fieldset>
    <legend class="t-h3 trail-title">Pa&rsquo;s Place spot-it trail</legend>
    <p class="trail-description">Tick each one when you spot it on your visit.</p>
    <div class="trail-finds">
      {
        finds.map((find) => (
          <label><input type="checkbox" value={find.id} /><span>{find.label}</span></label>
        ))
      }
    </div>
  </fieldset>
  <div class="trail-status" hidden>
    <output aria-live="polite"></output>
    <button type="button">Start again</button>
  </div>
</spot-it-trail>

<style>
  .trail {
    display: block;
    margin-top: 1.75rem;
    padding: 0.9rem 1rem 0.85rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 12px;
    background: var(--color-raised);
  }

  .trail-art {
    display: block;
    width: 100%;
    height: auto;
    max-height: 180px;
    object-fit: contain;
    margin-bottom: 0.55rem;
  }

  .trail-title {
    padding: 0;
  }

  .trail-description,
  .trail-status {
    color: var(--color-ink-muted);
    font-size: 0.875rem;
  }

  .trail-description {
    margin-top: 0.2rem;
  }

  .trail-finds {
    margin-top: 0.45rem;
  }

  label {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 0.65rem;
    padding-block: 0.25rem;
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  label + label {
    border-block-start: 1px solid var(--color-line);
  }

  input[type="checkbox"] {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    accent-color: var(--coast-blue);
  }

  .trail-status:not([hidden]) {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border-block-start: 1px solid var(--color-line);
  }

  button {
    min-height: 44px;
    color: var(--coast-blue);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }
</style>

<script>
  class SpotItTrail extends HTMLElement {
    connectedCallback() {
      const checks = [...this.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
      const status = this.querySelector<HTMLElement>('.trail-status');
      const output = this.querySelector<HTMLOutputElement>('output');
      if (!status || !output) return;

      const key = 'pas-place-spot-it-trail';
      try {
        const saved = localStorage.getItem(key)?.split(',') ?? [];
        for (const check of checks) check.checked = saved.includes(check.value);
      } catch {
        // The checklist still works when browser storage is unavailable.
      }

      const update = () => {
        const found = checks.filter((check) => check.checked);
        output.value = found.length === checks.length
          ? 'You spotted them all!'
          : `${found.length} of ${checks.length} spotted`;
        try {
          localStorage.setItem(key, found.map((check) => check.value).join(','));
        } catch {
          // Progress stays on the current page when browser storage is unavailable.
        }
      };

      this.onchange = update;
      const reset = this.querySelector('button');
      if (reset) reset.onclick = () => {
        for (const check of checks) check.checked = false;
        update();
      };
      update();
      status.hidden = false;
    }
  }

  customElements.define('spot-it-trail', SpotItTrail);
</script>
