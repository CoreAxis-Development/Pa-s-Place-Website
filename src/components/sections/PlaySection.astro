---
interface Props {
  id?: string;
  label?: string;
  labelledBy?: string;
  tone?: 'pool' | 'sun';
}

const { id, label, labelledBy, tone = 'pool' } = Astro.props;
---

<section id={id} aria-label={label} aria-labelledby={labelledBy} class="section play-section" data-coast-wash={tone === 'sun' ? 'sand' : 'sea'}>
  <div class="container-page">
    <slot />
  </div>
</section>

<style>
  .play-section {
    border-block-start: 1px solid var(--color-line);
  }
</style>
