---
import type { VenuePage } from '../../server/services/documents';
import type { Picture as VenuePhoto } from '../../server/services/media';
import Picture from '../ui/Picture.astro';

interface Props {
  photo?: VenuePhoto | null;
  canBook: boolean;
  copy: VenuePage['birthday'];
}

const { photo, canBook, copy } = Astro.props;
const scenes = [
  { art: 'cake', ...copy.cake },
  { art: 'golf', ...copy.golf },
  { art: 'slide', ...copy.slide },
] as const;
---

<section id="kids-parties" class="section" data-coast-wash="sand" aria-labelledby="kids-parties-title">
  <div class="container-page">
    <p class="eyebrow">The birthday playbook</p>
    <h2 id="kids-parties-title" class="t-h2 mt-2">{copy.title}</h2>
    <p class="t-lead mt-3 max-w-[49ch]">{copy.intro}</p>

    <div class="party-book">
      {
        scenes.map((scene) => (
          <article class="party-page">
            <div class="party-scene" data-scene={scene.art}>
              <span class="party-doodle" data-doodle={scene.art} aria-hidden="true"></span>
            </div>
            <div class="party-story">
              <h3 class="t-h3">{scene.title}</h3>
              <p>{scene.text}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class:list={['party-plan', photo && 'has-party-photo']}>
      {
        photo && (
          <figure class="party-photo">
            <Picture image={photo} sizes="(min-width: 900px) 250px, 85vw" class="aspect-[16/10] w-full object-cover" />
            {photo.caption && <figcaption class="t-caption mt-2">{photo.caption}</figcaption>}
          </figure>
        )
      }
      <div>
        <h3 class="t-h3">{copy.planningTitle}</h3>
        <p class="mt-2 max-w-[49ch]">{copy.planningText}</p>
        <div class="party-actions">
          {canBook && <a href="#book" class="btn btn-primary">Check a party date</a>}
          <a href="/contact?about=venue#enquiry" class:list={['btn', canBook ? 'btn-tertiary' : 'btn-primary']}>Ask about your party</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .party-book {
    display: grid;
    margin-top: clamp(1.3rem, 3vw, 2.25rem);
    border: 1px solid var(--color-line-strong);
    border-radius: 12px;
    background: var(--color-raised);
    box-shadow: 0 4px 0 -1px var(--color-sunken), 0 5px 0 -1px var(--color-line-strong);
  }

  .party-page {
    display: grid;
    grid-template-columns: minmax(0, 5.5rem) minmax(0, 1fr);
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    padding: clamp(0.85rem, 2.6vw, 1.65rem);
  }

  .party-page + .party-page {
    border-top: 1px dashed var(--color-line-strong);
  }

  .party-scene {
    position: relative;
    isolation: isolate;
    width: 100%;
    aspect-ratio: 1;
  }

  .party-scene::before {
    position: absolute;
    z-index: -1;
    inset: 10% 4% 4%;
    border-radius: 53% 45% 51% 46%;
    background: var(--party-paint);
    content: "";
  }

  .party-scene[data-scene="cake"] { --party-paint: #f8e0d3; }
  .party-scene[data-scene="golf"] { --party-paint: #e4efd6; }
  .party-scene[data-scene="slide"] { --party-paint: #dceef1; }

  .party-scene .party-doodle {
    width: 100%;
  }

  .party-story p {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
  }

  .party-plan {
    display: grid;
    gap: 1.15rem;
    align-items: center;
    margin-top: clamp(1.5rem, 4vw, 2.75rem);
  }

  .party-photo {
    min-width: 0;
    padding: 0.45rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-raised);
  }

  .party-photo :global(img) {
    display: block;
    border-radius: 4px;
    object-position: center 76%;
  }

  .party-photo figcaption {
    margin-inline: 0.15rem;
  }

  .party-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .party-actions .btn-tertiary {
    background: var(--color-raised);
  }

  @media (min-width: 720px) {
    .party-book {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .party-page {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
    }

    .party-page + .party-page {
      border-top: 0;
      border-inline-start: 1px solid var(--color-line);
    }

    .party-scene {
      width: min(100%, 11rem);
      margin-inline: auto;
    }

    .party-plan.has-party-photo {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
