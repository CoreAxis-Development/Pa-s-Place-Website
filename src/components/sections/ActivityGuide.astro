---
import type { PublicAmenity } from '../../server/services/content';
import Icon from '../ui/Icon.astro';
import Picture from '../ui/Picture.astro';

interface Props {
  amenities: PublicAmenity[];
  title: string;
  intro: string;
}

const { amenities, title, intro } = Astro.props;
const featured = amenities.find((amenity) => amenity.image);
const others = amenities.filter((amenity) => amenity.id !== featured?.id);
---

<section id="grounds" class="grounds-guide" aria-labelledby="grounds-title">
  <div class="container-page">
    <div class="grounds-intro">
      <div>
        <h2 id="grounds-title" class="t-h2">{title}</h2>
        <p class="t-lead mt-3 max-w-[52ch]">{intro}</p>
      </div>
      <a class="link grounds-gallery inline-flex items-center gap-2" href="/gallery">
        See the gallery <Icon name="arrow" class="h-4 w-4 shrink-0" />
      </a>
    </div>

    <div class:list={['grounds-spread', featured?.image && others.length > 0 && 'grounds-spread-paired']}>
      {
        featured?.image && (
          <article class="grounds-feature">
            <Picture image={featured.image} sizes="(min-width: 900px) 620px, 92vw" class="grounds-feature-photo" />
            <div class="grounds-feature-note">
              <span class="grounds-icon"><Icon name={featured.icon} /></span>
              <div>
                <h3 class="t-h3">{featured.title}</h3>
                <p>{featured.description}</p>
              </div>
            </div>
          </article>
        )
      }

      {
        others.length > 0 && (
          <div class="grounds-stops">
            {others.map((amenity) => (
              <article class:list={['grounds-stop', amenity.image && 'grounds-stop-with-photo']}>
                {
                  amenity.image
                    ? <Picture image={amenity.image} sizes="104px" class="grounds-stop-photo" />
                    : <span class="grounds-icon"><Icon name={amenity.icon} /></span>
                }
                <div>
                  <h3 class="t-h4">{amenity.title}</h3>
                  <p>{amenity.description}</p>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .grounds-guide {
    padding-block: clamp(2.65rem, 6vw, 5.25rem);
    background: var(--color-canopy-50);
  }

  .grounds-intro {
    display: grid;
    align-items: end;
    gap: 0.85rem 2rem;
    margin-bottom: clamp(1.2rem, 3vw, 2rem);
  }

  .grounds-gallery {
    width: fit-content;
  }

  .grounds-spread {
    display: grid;
    gap: 1.25rem 2rem;
    align-items: start;
  }

  .grounds-feature {
    display: grid;
    gap: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 2rem 0.7rem 0.7rem;
    background: var(--color-raised);
  }

  .grounds-feature :global(.grounds-feature-photo) {
    display: block;
    width: 100%;
    aspect-ratio: 1.65;
    object-fit: cover;
    object-position: center 69%;
  }

  .grounds-feature-note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding: 0.9rem clamp(0.8rem, 2vw, 1.25rem);
  }

  .grounds-feature-note p,
  .grounds-stop p {
    margin-top: 0.18rem;
    font-size: 0.9375rem;
  }

  .grounds-stops {
    border-block: 1px solid var(--color-line-strong);
  }

  .grounds-stop {
    display: grid;
    grid-template-columns: 2.3rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding-block: 0.85rem;
  }

  .grounds-stop + .grounds-stop {
    border-top: 1px solid var(--color-line);
  }

  .grounds-stop-with-photo {
    grid-template-columns: clamp(4.3rem, 16vw, 6rem) minmax(0, 1fr);
    align-items: center;
  }

  .grounds-stop :global(.grounds-stop-photo) {
    display: block;
    width: 100%;
    aspect-ratio: 1.2;
    border-radius: 7px;
    object-fit: cover;
  }

  .grounds-icon {
    display: grid;
    width: 2.3rem;
    height: 2.3rem;
    place-items: center;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    color: var(--color-canopy-600);
    background: var(--color-raised);
  }

  @media (min-width: 900px) {
    .grounds-intro {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .grounds-spread-paired {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
  }
</style>
