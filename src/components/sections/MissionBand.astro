---
interface Props {
  title: string;
  text: string;
  sponsor?: boolean;
  moreHref?: string;
  moreLabel?: string;
}

const { title, text, sponsor = false, moreHref = '/our-story', moreLabel = 'Read our story' } = Astro.props;
---

<section class="mission-band" aria-labelledby="mission-band-title">
  <div class="container-page mission-layout">
    <div>
      <h2 class="t-h2" id="mission-band-title">{title}</h2>
      <p class="mt-3 max-w-[64ch]">{text}</p>
    </div>
    <div class="mission-actions">
      {sponsor && <a href="/contact?about=sponsor#enquiry" class="btn btn-primary">Sponsor a child&rsquo;s holiday</a>}
      <a href={moreHref} class={sponsor ? 'link' : 'btn btn-tertiary'}>{moreLabel}</a>
    </div>
  </div>
</section>

<style>
  .mission-band {
    border-top: 1px solid var(--color-line);
    background: var(--coast-pool);
    padding-block: clamp(1.8rem, 4vw, 3.4rem);
  }

  .mission-layout {
    display: grid;
    align-items: center;
    gap: 1rem 2.2rem;
  }

  .mission-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
  }

  @media (min-width: 900px) {
    .mission-layout {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
