---
// Shared mission panel with a link to the story or a related support page.
import Dove from '../story/Dove.astro';
import Sunrise from '../ui/Sunrise.astro';

interface Props {
  title: string;
  text: string;
  /** show the sponsor call to action (on /get-involved and /what-we-do) */
  sponsor?: boolean;
  moreHref?: string;
  moreLabel?: string;
}
const { title, text, sponsor = false, moreHref = '/our-story', moreLabel = 'Read our story' } = Astro.props;
---

<section class="on-dark relative overflow-hidden bg-canopy-900 py-14 text-on-dark sm:py-18" aria-label="Our cause">
  <Sunrise class="pointer-events-none absolute -right-24 -top-28 h-[280px] w-[280px] opacity-35" />
  <div class="container-page relative grid items-center gap-6 lg:grid-cols-[1fr_auto] lg:gap-12">
    <div>
      <Dove class="h-11 w-11" />
      <h2 class="t-h2 mt-3 max-w-2xl !text-on-dark">{title}</h2>
      <p class="t-lead mt-3 max-w-[55ch] text-on-dark-muted">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3 lg:flex-col lg:items-start">
      {sponsor && <a href="/contact?about=sponsor#enquiry" class="btn btn-primary">Sponsor a child&rsquo;s holiday</a>}
      <a href={moreHref} class="btn btn-on-dark">{moreLabel}</a>
    </div>
  </div>
</section>
