---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getSite } from '../server/services/content';

interface Props {
  title?: string;
  description?: string;
  /** social-share image URL */
  image?: string;
}

const { settings } = await getSite();
const { title, description = settings.tagline, image } = Astro.props;
const pageTitle = title ? `${title} | ${settings.siteName}` : `${settings.siteName} | ${settings.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const a = settings.announcement;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.url.origin).href} />}
    <meta name="theme-color" content="#12241A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-[10px] focus:bg-canopy-900 focus:px-5 focus:py-3 focus:font-bold focus:text-on-dark"
    >
      Skip to content
    </a>
    {
      a.enabled && a.text && (
        <div class="on-dark bg-canopy-900 text-on-dark">
          <p class="container-page py-2 text-center text-sm font-medium">
            {a.href ? <a href={a.href} class="underline underline-offset-2">{a.text}</a> : a.text}
          </p>
        </div>
      )
    }
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
