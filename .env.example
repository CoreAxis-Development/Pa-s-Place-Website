# ---- First owner account ----
# Created on first start when no staff accounts exist. Required in production.
# In local development, leaving these unset creates the default development
# owner, who can sign in as admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---- Storage ----
# Where the embedded database and uploaded photos live locally. On Railway
# leave this unset to use the mounted volume, or set it to /data (or a path on it).
DATA_DIR=./data
# Optional: use a real Postgres instead of the embedded one (recommended once
# the site is busy; Railway's Postgres plugin provides this value).
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Optional: put photos somewhere other than DATA_DIR/media.
# MEDIA_DIR=

# ---- Email notifications (optional) ----
# Without SMTP_HOST no email is sent; enquiries and bookings still appear in
# the admin portal.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Pa's Place <info@pasplace.co.za>"
# Public address of the site, used for links inside notification emails.
# SITE_URL=https://www.pasplace.co.za
